{
  "name": "searchhighlight",
  "displayName": "SearchHighlight",
  "description": "SearchHighlight主要功能是搜索代码变量和函数以及其他字符并根据搜索到的字符串所在行中的读写属性来显示不同的颜色",
  "version": "1.3.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onCommand:searchhighlight.searchAndHighlight"
  ],
  "main": "./out/extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/JackyWongX/searchhighlight"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "search-highlight",
          "title": "Search Highlight",
          "icon": "$(search)"
        }
      ]
    },
    "views": {
      "search-highlight": [
        {
          "id": "searchHighlightResults",
          "name": "Search Results",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "searchhighlight.searchAndHighlight",
        "title": "Search and Highlight Selected Text"
      },
      {
        "command": "searchhighlight.reloadPatterns",
        "title": "Reload Write Operation Patterns"
      },
      {
        "command": "searchhighlight.focus",
        "title": "Focus Search Results View"
      },
      {
        "command": "searchhighlight.clearHighlight",
        "title": "Clear Search Highlighting"
      }
    ],
    "keybindings": [
      {
        "command": "searchhighlight.searchAndHighlight",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "editorFocus && editorTextFocus"
      },
      {
        "command": "searchhighlight.clearHighlight",
        "key": "escape",
        "when": "editorTextFocus && searchHighlightActive"
      }
    ],
    "configuration": {
      "title": "Search Highlight",
      "properties": {
        "searchhighlight.patterns": {
          "type": "object",
          "default": {
            "common": {
              "operators": [
                ">>>=",
                "<<=",
                ">>=",
                "**=",
                "//=",
                "&&=",
                "||=",
                "??=",
                "+=",
                "-=",
                "*=",
                "/=",
                "%=",
                "&=",
                "|=",
                "^=",
                ".=",
                "++",
                "--",
                "<-",
                ":=",
                "="
              ],
              "methods": [
                "add",
                "addall",
                "addfirst",
                "addlast",
                "append",
                "appendleft",
                "assign",
                "clear",
                "decrement",
                "delete",
                "discard",
                "dispose",
                "emplace",
                "emplace_back",
                "emplace_hint",
                "erase",
                "extend",
                "fill",
                "increment",
                "insert",
                "insertat",
                "merge",
                "move",
                "patch",
                "pop",
                "pop_back",
                "popleft",
                "popitem",
                "push",
                "push_back",
                "pushback",
                "put",
                "putall",
                "remove",
                "removeall",
                "removeat",
                "reset",
                "reserve",
                "resize",
                "reverse",
                "save",
                "set",
                "setattr",
                "setdefault",
                "setvalue",
                "shift",
                "shuffle",
                "sort",
                "splice",
                "store",
                "swap",
                "truncate",
                "tryadd",
                "unshift",
                "update",
                "write",
                "writelines"
              ],
              "functions": [
                "append",
                "assign",
                "clear",
                "copy",
                "delete",
                "emplace",
                "emplace_back",
                "erase",
                "fgets",
                "fill",
                "gets",
                "insert",
                "memcpy",
                "memmove",
                "memset",
                "push_back",
                "reverse",
                "shuffle",
                "sort",
                "sprintf",
                "snprintf",
                "strcat",
                "strcpy",
                "strncpy",
                "swap"
              ],
              "excludeOperators": [
                "===",
                "!==",
                "==",
                "!=",
                "=~",
                "=>",
                ">=",
                "<=",
                ">",
                "<"
              ]
            }
          },
          "description": "写操作检测的关键字配置。可以按语言配置多个分组，检测时会把所有分组合并使用。",
          "markdownDescription": "写操作检测的关键字配置，可以按语言分成多组（例如 `common`、`go`、`python`），检测时会合并所有分组。\n- `operators`: 赋值运算符，如 `=`、`+=`、`:=`、`??=`\n- `methods`: 会修改自身的成员方法名，如 `append`、`add`、`setX`\n- `functions`: 会修改第一个实参的函数名，如 `append(xs, v)`、`memcpy(dst, src)`\n- `excludeOperators`: 不能当成赋值的运算符，如 `==`、`=>`（内置的比较运算符始终生效）",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "operators": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "赋值运算符列表"
              },
              "methods": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "会修改自身的成员方法名列表"
              },
              "functions": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "会修改第一个实参的函数名列表"
              },
              "excludeOperators": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "不能当成赋值的运算符列表"
              }
            }
          }
        },
        "searchhighlight.colors.read": {
          "type": "string",
          "default": "rgba(64, 200, 64, 0.5)",
          "description": "读操作高亮颜色"
        },
        "searchhighlight.colors.write": {
          "type": "string",
          "default": "rgba(240, 64, 64, 0.5)",
          "description": "写操作高亮颜色"
        },
        "searchhighlight.excludePatterns": {
          "type": "array",
          "default": [
            ".git",
            ".svn",
            ".hg",
            ".vs",
            ".vscode",
            "node_modules",
            "dist",
            "build",
            "target",
            "bin",
            "obj",
            "out",
            "temp",
            "tmp",
            "coverage",
            "__pycache__",
            "*.egg-info",
            "vendor"
          ],
          "description": "要排除的目录列表",
          "items": {
            "type": "string"
          }
        },
        "searchhighlight.matchWholeWord": {
          "type": "boolean",
          "default": true,
          "description": "是否全词匹配"
        },
        "searchhighlight.caseSensitive": {
          "type": "boolean",
          "default": true,
          "description": "是否区分大小写"
        },
        "searchhighlight.excludeFileExtensions": {
          "type": "array",
          "default": [
            ".pb.h",
            ".pb.cc",
            ".generated.h",
            ".generated.cpp",
            ".g.cs",
            ".designer.cs",
            ".min.js",
            ".min.css",
            ".d.ts",
            ".map",
            ".pyc",
            ".pyo",
            ".pyd",
            ".dll",
            ".exe",
            ".so",
            ".dylib",
            ".lib",
            ".obj",
            ".o",
            ".class",
            ".cache"
          ],
          "description": "要排除的文件后缀列表。这些后缀的文件将在搜索时被忽略。",
          "items": {
            "type": "string"
          }
        },
        "searchhighlight.respectGitIgnore": {
          "type": "boolean",
          "default": false,
          "description": "是否遵循 .gitignore、.ignore 等忽略规则。关闭时会搜索所有文件（仍受排除目录和后缀配置约束）。"
        },
        "searchhighlight.ripgrepPath": {
          "type": "string",
          "default": "",
          "description": "ripgrep 可执行文件的绝对路径。留空时先找 VS Code 安装目录里的 ripgrep，找不到再找 Cursor、Trae 等编辑器，最后再找 PATH。这些地方都没有时会提示设置此项。"
        },
        "searchhighlight.debug": {
          "type": "boolean",
          "default": false,
          "description": "是否在开发者工具的输出面板中打印调试日志。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "publisher": "JackyWong",
  "icon": "images/icon.png",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^8.28.0",
    "@typescript-eslint/parser": "^8.28.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.23.0",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "iconv-lite": "^0.6.3",
    "jschardet": "^3.1.4"
  }
}
